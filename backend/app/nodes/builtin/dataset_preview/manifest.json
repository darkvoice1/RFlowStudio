{
  "key": "dataset_preview",
  "name": "数据预览",
  "category": "inspection",
  "description": "查看当前数据集的分页预览内容。",
  "aliases": ["preview", "data_preview"],
  "executor_kind": "builtin",
  "config_schema": {
    "type": "object",
    "properties": {
      "offset": {
        "type": "integer",
        "minimum": 0,
        "default": 0
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "default": 20
      }
    },
    "additionalProperties": true
  },
  "input_schema": [
    {
      "key": "dataset_ref",
      "name": "数据引用",
      "data_type": "dataset",
      "required": true
    }
  ],
  "output_schema": [
    {
      "key": "preview_table",
      "name": "预览表格",
      "data_type": "table",
      "required": true
    }
  ]
}
